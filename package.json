{
  "name": "simplepixelart-mcp",
  "version": "0.1.0",
  "description": "MCP server for pixel art: turn images into pixel art, extract and remap palettes (PICO-8, Game Boy, ENDESGA 32…), and upscale sprites without blur.",
  "type": "module",
  "bin": { "simplepixelart-mcp": "src/index.js" },
  "main": "src/pixel.js",
  "files": ["src", "README.md", "LICENSE"],
  "scripts": { "start": "node src/index.js", "test": "node test/run.js" },
  "keywords": ["mcp", "model-context-protocol", "pixel-art", "pixelate", "palette", "sprite", "gamedev", "image-to-pixel-art", "pico-8", "claude", "cursor"],
  "homepage": "https://simplepixelart.com/",
  "repository": { "type": "git", "url": "git+https://github.com/comficker/pixel-art-mcp.git" },
  "bugs": { "url": "https://github.com/comficker/pixel-art-mcp/issues" },
  "author": "Comficker (https://simplepixelart.com)",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^3.24.0"
  }
}
