{
  "name": "simplepixelart-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.comficker/pixel-art-mcp",
  "description": "Pixel art MCP server: turn images into pixel art, extract and remap palettes (PICO-8, Game Boy), upscale sprites without blur. Free, local, no API key.",
  "type": "module",
  "bin": {
    "simplepixelart-mcp": "src/index.js"
  },
  "main": "src/pixel.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/run.js",
    "start:http": "node src/http.js",
    "test:http": "node test/http.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pixel-art",
    "image-to-pixel-art",
    "pixelate",
    "pixel-art-converter",
    "sprite",
    "sprite-generator",
    "palette",
    "pico-8",
    "gameboy",
    "upscale",
    "nearest-neighbor",
    "gamedev",
    "claude",
    "cursor",
    "ai-tools",
    "aseprite",
    "godot"
  ],
  "homepage": "https://simplepixelart.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comficker/pixel-art-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/comficker/pixel-art-mcp/issues"
  },
  "author": "Comficker (https://simplepixelart.com)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jpeg-js": "^0.4.4",
    "pixel-art-palettes": "^1.0.0",
    "pngjs": "^7.0.0",
    "zod": "^3.24.0"
  }
}
